<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="E3_Barroc_Intens.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:E3_Barroc_Intens">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Huisstijl -->
            <Color x:Key="BarrocDark">#212121</Color>
            <Color x:Key="BarrocYellow">#FFD700</Color>
            <SolidColorBrush x:Key="BarrocDarkBrush" Color="{StaticResource BarrocDark}" />
            <SolidColorBrush x:Key="BarrocYellowBrush" Color="{StaticResource BarrocYellow}" />
            <FontFamily x:Key="HeadingFont">/Assets/Fonts/BigShouldersDisplay-Bold.ttf#Big Shoulders Display</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>