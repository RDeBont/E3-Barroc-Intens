<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="E3_Barroc_Intens.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:E3_Barroc_Intens"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Barroc Intens">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{StaticResource BarrocDarkBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="20,20" BorderBrush="{StaticResource BarrocMenuLijnBrush}" BorderThickness="0,0,0,1">
                <Image Source="{StaticResource LogoMenubalk}" Height="44" HorizontalAlignment="Left" />
            </Border>

            <ScrollViewer Grid.Row="1" Padding="0,8,0,0">
                <StackPanel x:Name="MenuPanel" />
            </ScrollViewer>

            <Border Grid.Row="2" Padding="20,16" BorderBrush="{StaticResource BarrocMenuLijnBrush}" BorderThickness="0,1,0,0">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="UserInfoText" Foreground="{StaticResource BarrocMenuTekstGrijsBrush}" FontSize="13" />
                    <Button Content="Uitloggen" Style="{StaticResource UitlogKnopStyle}" Click="LogoutButton_Click" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Frame x:Name="detailFrame" Grid.Column="1" Background="{StaticResource BarrocWhiteBrush}" />
    </Grid>
</Window>
