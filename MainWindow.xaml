<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="E3_Barroc_Intens.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:E3_Barroc_Intens"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="E3-Barroc-Intens">

    <ScrollViewer Background="{StaticResource BarrocWhiteBrush}">
        <StackPanel Padding="40" Spacing="12" MaxWidth="700" HorizontalAlignment="Left">
            <Image Source="{StaticResource LogoMetSlogan}" Height="120" HorizontalAlignment="Left" />

            <TextBlock Text="Klanten &amp; prospects" Style="{StaticResource PaginaTitelStyle}" />
            <TextBlock Text="Bezoekadres" Style="{StaticResource SectieKopStyle}" />
            <TextBlock Text="Dit is gewone tekst in Roboto." Style="{StaticResource BodyTekstStyle}" />

            <TextBlock Text="Naam" Style="{StaticResource LabelStyle}" />
            <TextBox PlaceholderText="Café De Kroon" />
            <TextBlock Text="Wachtwoord" Style="{StaticResource LabelStyle}" />
            <PasswordBox />
            <TextBlock Text="Rol" Style="{StaticResource LabelStyle}" />
            <ComboBox PlaceholderText="Kies een rol">
                <x:String>Sales</x:String>
                <x:String>Finance</x:String>
            </ComboBox>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Annuleren" Style="{StaticResource SecundaireKnopStyle}" />
                <Button Content="Opslaan" Style="{StaticResource HoofdknopStyle}" />
            </StackPanel>

            <Border Style="{StaticResource TabelKopStyle}" Margin="0,16,0,0">
                <Grid ColumnDefinitions="2*,*,*">
                    <TextBlock Text="Naam" Style="{StaticResource TabelKopTekstStyle}" />
                    <TextBlock Grid.Column="1" Text="Plaats" Style="{StaticResource TabelKopTekstStyle}" />
                    <TextBlock Grid.Column="2" Text="Status" Style="{StaticResource TabelKopTekstStyle}" />
                </Grid>
            </Border>
            <ListView ItemContainerStyle="{StaticResource TabelRijStyle}" SelectionMode="Single" Margin="0,-12,0,0">
                <ListViewItem>
                    <Grid ColumnDefinitions="2*,*,*">
                        <TextBlock Text="Café De Kroon" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Breda" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Klant" VerticalAlignment="Center" />
                    </Grid>
                </ListViewItem>
                <ListViewItem>
                    <Grid ColumnDefinitions="2*,*,*">
                        <TextBlock Text="Hotel Zuid" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Tilburg" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Prospect" VerticalAlignment="Center" />
                    </Grid>
                </ListViewItem>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Window>
