<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Kleuren hoofdknop -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#FFD700" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#E6C200" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#CCAC00" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#212121" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#212121" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#212121" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#212121" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Kleuren (huisstijlhandboek) -->
    <SolidColorBrush x:Key="BarrocDarkBrush" Color="#212121" />
    <SolidColorBrush x:Key="BarrocYellowBrush" Color="#FFD700" />
    <SolidColorBrush x:Key="BarrocWhiteBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BarrocGrijsLichtBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="BarrocGrijsRandBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="BarrocTekstGrijsBrush" Color="#666666" />

    <!-- Fonts -->
    <FontFamily x:Key="HeadingFont">ms-appx:///Assets/Fonts/BigShouldersDisplay-Bold.ttf#Big Shoulders Display</FontFamily>
    <FontFamily x:Key="BodyFont">ms-appx:///Assets/Fonts/Roboto-Regular.ttf#Roboto</FontFamily>
    <FontFamily x:Key="BodyFontBold">ms-appx:///Assets/Fonts/Roboto-Bold.ttf#Roboto</FontFamily>

    <!-- Roboto als standaardfont voor alle controls (knoppen, invoervelden, lijsten) -->
    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Roboto-Regular.ttf#Roboto</FontFamily>

    <!-- Logo's -->
    <BitmapImage x:Key="LogoMetSlogan" UriSource="ms-appx:///Assets/Logo/Logo1_groot.png" />
    <BitmapImage x:Key="LogoGroot" UriSource="ms-appx:///Assets/Logo/Logo6_groot.png" />
    <BitmapImage x:Key="LogoBit" UriSource="ms-appx:///Assets/Logo/Logo5_groot.png" />

    <!-- Koppen en tekst -->
    <Style x:Key="PaginaTitelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="Foreground" Value="{StaticResource BarrocDarkBrush}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="SectieKopStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource BarrocDarkBrush}" />
        <Setter Property="Margin" Value="0,16,0,8" />
    </Style>

    <Style x:Key="BodyTekstStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource BarrocDarkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="LabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource BarrocTekstGrijsBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- Knoppen -->
    <Style x:Key="HoofdknopStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontBold}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style x:Key="SecundaireKnopStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- Invoervelden (geen x:Key = geldt automatisch voor alle velden in de app) -->
    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- Tabellen (ListView met een kopregel) -->
    <Style x:Key="TabelKopStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BarrocGrijsLichtBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BarrocDarkBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="TabelKopTekstStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontBold}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource BarrocDarkBrush}" />
    </Style>

    <Style x:Key="TabelRijStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="BorderBrush" Value="{StaticResource BarrocGrijsRandBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

</ResourceDictionary>